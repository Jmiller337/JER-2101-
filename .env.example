# Copy to .env.local for local development. Never commit the real values.

# Your Anthropic API key, from https://platform.claude.com (Settings, API keys).
ANTHROPIC_API_KEY=

# The passcode the phone must enter once before the app will read anything.
# Pick something long enough that a stranger cannot guess it.
APP_PASSCODE=

# Translate documents in these languages into English (only "fr" for now). Off when empty.
# Built but not switched on for the phone yet; see docs/SETUP.md, "Translating French documents".
TRANSLATE_FROM=
